<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".XingXiaApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.XingXia">

        <!-- 旋转、深浅色切换、折叠屏展开等由 Compose 自行响应，不重建 Activity，编辑中的表单和进行中的占卜不会丢 -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode|keyboardHidden|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 深链接：xingxia://tool/coin、xingxia://fortune 等，与 iOS 版一致 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="xingxia" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <receiver android:name=".system.ReminderReceiver" android:exported="false" />
        <!-- 跨天刷新小组件：DATE_CHANGED 在 Android 8+ 不再发给静态 receiver，改由 AlarmManager 每天零点后触发 -->
        <receiver android:name=".system.DayChangeReceiver" android:exported="false" />
        <receiver android:name=".system.BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!-- 小组件配置：添加或长按重新设置时选择星座 / 倒数日 -->
        <activity
            android:name=".system.HoroscopeWidgetConfigActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="选择星座"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity
            android:name=".system.CountdownWidgetConfigActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="选择倒数日"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver android:name=".system.FortuneWidgetReceiver" android:exported="true" android:label="今日运势">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/fortune_widget_info" />
        </receiver>
        <receiver android:name=".system.HoroscopeWidgetReceiver" android:exported="true" android:label="星座运势">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/horoscope_widget_info" />
        </receiver>
        <receiver android:name=".system.CountdownWidgetReceiver" android:exported="true" android:label="倒数日">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/countdown_widget_info" />
        </receiver>
    </application>
</manifest>
